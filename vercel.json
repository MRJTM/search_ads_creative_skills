{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd webs/front && npm ci && npm run build",
  "outputDirectory": "webs/front/dist",
  "functions": {
    "api/app.py": {
      "includeFiles": "{../agent/**,../webs/backend/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/app.py" },
    { "source": "/materials/(.*)", "destination": "/api/app.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
