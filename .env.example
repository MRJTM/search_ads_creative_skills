TOPAPI_API_KEY=your-topapi-api-key
TOPAPI_BASE_URL=https://toapis.cn/v1
# Optional when the backend must use a local HTTP proxy, for example http://127.0.0.1:7890
TOPAPI_PROXY_URL=
TOPAPI_TIMEOUT_SECONDS=90
# Conversation agent (tool decisions + final natural replies)
AGENT_MODEL=qwen3.5-flash
AGENT_MAX_TOKENS=256
FINAL_MAX_TOKENS=256
# Vision understanding (offline precompute + runtime parallel misses); results are cached per image
VISION_MODEL=deepseek-v4-flash-vision-exp
VISION_TIMEOUT_SECONDS=60
VISION_MAX_TOKENS=3000
MATERIAL_ANALYSIS_WORKERS=5
IMAGE_MODEL=gpt-image-2
# Supabase Storage: when SUPABASE_URL is set, /api/materials loads
# catalog.json from the bucket's public URL and /materials/{filename}
# redirects to the bucket. SECRET_KEY only needed for writes/uploads.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=search_ads_creative_skills
